{
  "name": "cdp-codegen",
  "displayName": "CDP Code Generator",
  "description": "Code generator for CDP Studio CDPComponent classes - add/remove/change Signals, Parameters, Alarms, Properties, Connectors, States, StateTransitions, Messages, and Ports",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:xml",
    "workspaceContains:**/Application/Application.xml",
    "onCommand:cdp.rebuildRoutingIndex",
    "onCommand:cdp.showRoutingIndexStats",
    "onCommand:cdp.copyPath",
    "onCommand:cdp.copyAbsolutePath",
    "onCommand:cdp.copyRelativePath",
    "onCommand:cdp.copyRoutingValue",
    "onCommand:cdp.copyRoutingFromContext",
    "onCommand:cdp.pasteAsRouting"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "cdp.addSignal", "title": "CDP: Add Signal" },
      { "command": "cdp.addParameter", "title": "CDP: Add Parameter" },
      { "command": "cdp.addAlarm", "title": "CDP: Add Alarm" },
      { "command": "cdp.addProperty", "title": "CDP: Add Property" },
      { "command": "cdp.addConnector", "title": "CDP: Add Connector" },
      { "command": "cdp.addState", "title": "CDP: Add State" },
      { "command": "cdp.addStateTransition", "title": "CDP: Add State Transition" },
      { "command": "cdp.addMessage", "title": "CDP: Add Message" },
      { "command": "cdp.addPort", "title": "CDP: Add Port" },
      { "command": "cdp.remove", "title": "CDP: Remove Element" },
      { "command": "cdp.change", "title": "CDP: Change Element" },
      { "command": "cdp.rebuildRoutingIndex", "title": "CDP: Rebuild Routing Index" },
      { "command": "cdp.validateRoutingCurrentFile", "title": "CDP: Validate Routing In Current File" },
      { "command": "cdp.validateRoutingWorkspace", "title": "CDP: Validate Routing In Workspace" },
      { "command": "cdp.showRoutingTarget", "title": "CDP: Show Routing Target" },
      { "command": "cdp.showRoutingIndexStats", "title": "CDP: Show Routing Index Stats" },
      { "command": "cdp.copyPath", "title": "CDP: Copy Path" },
      { "command": "cdp.copyAbsolutePath", "title": "CDP: Copy Absolute Path" },
      { "command": "cdp.copyRelativePath", "title": "CDP: Copy Relative Path From Current Context" },
      { "command": "cdp.copyRoutingValue", "title": "CDP: Copy Routing Value" },
      { "command": "cdp.copyRoutingFromContext", "title": "CDP: Copy Routing From Current Context" },
      { "command": "cdp.pasteAsRouting", "title": "CDP: Paste As Routing" }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "cdp.add",
          "group": "cdp@1",
          "when": "resourceLangId == cpp || resourceExtname == .h"
        },
        {
          "command": "cdp.remove",
          "group": "cdp@2",
          "when": "resourceLangId == cpp || resourceExtname == .h"
        },
        {
          "command": "cdp.change",
          "group": "cdp@3",
          "when": "resourceLangId == cpp || resourceExtname == .h"
        },
        {
          "command": "cdp.copyPath",
          "group": "cdp_xml@1",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "cdp.copyAbsolutePath",
          "group": "cdp_xml@2",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "cdp.copyRoutingValue",
          "group": "cdp_xml@3",
          "when": "resourceExtname == .xml"
        },
        {
          "command": "cdp.pasteAsRouting",
          "group": "cdp_xml@4",
          "when": "resourceExtname == .xml"
        }
      ],
      "cdp.add": [
        { "command": "cdp.addSignal", "group": "1_members@1" },
        { "command": "cdp.addParameter", "group": "1_members@2" },
        { "command": "cdp.addAlarm", "group": "1_members@3" },
        { "command": "cdp.addProperty", "group": "1_members@4" },
        { "command": "cdp.addConnector", "group": "1_members@5" },
        { "command": "cdp.addState", "group": "2_model@1" },
        { "command": "cdp.addStateTransition", "group": "2_model@2" },
        { "command": "cdp.addMessage", "group": "2_model@3" },
        { "command": "cdp.addPort", "group": "3_port@1" }
      ]
    },
    "submenus": [
      {
        "id": "cdp.add",
        "label": "CDP: Add"
      }
    ],
    "configuration": {
      "title": "CDP Routing",
      "properties": {
        "cdp.routing.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CDP XML routing validation."
        },
        "cdp.routing.validation.strict": {
          "type": "boolean",
          "default": false,
          "description": "Treat unresolved local routing targets as warnings when possible. Default is conservative to avoid false errors."
        },
        "cdp.routing.validation.treatExternalAsError": {
          "type": "boolean",
          "default": false,
          "description": "Report external application routing as errors."
        },
        "cdp.routing.validation.treatModelInheritedAsError": {
          "type": "boolean",
          "default": false,
          "description": "Report model/library-inherited routing targets as errors."
        },
        "cdp.routing.navigation.goToNearestParentForModelInherited": {
          "type": "boolean",
          "default": true,
          "description": "For model-inherited targets, Go to Definition opens the nearest known parent element."
        },
        "cdp.routing.index.followSrc": {
          "type": "boolean",
          "default": true,
          "description": "Follow CDP XML src references while building routing index."
        },
        "cdp.routing.index.includeAllXmlFilesFallback": {
          "type": "boolean",
          "default": true,
          "description": "Also parse XML files not reached from Application.xml for best-effort hover/navigation, but do not emit red diagnostics for files with unknown context."
        },
        "cdp.routing.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable color decorations on CDP routing attribute values in XML files."
        },
        "cdp.routing.decorations.resolvedColor": {
          "type": "string",
          "default": "#00BFFF",
          "description": "Color for resolved routing values (bright cyan — link-like)."
        },
        "cdp.routing.decorations.invalidColor": {
          "type": "string",
          "default": "#F44747",
          "description": "Color for invalid routing values (red wavy)."
        },
        "cdp.routing.decorations.unresolvedColor": {
          "type": "string",
          "default": "#FF5722",
          "description": "Color for genuinely unresolved routing values (red-orange dotted — not usable)."
        },
        "cdp.routing.decorations.modelInheritedColor": {
          "type": "string",
          "default": "#D7BA7D",
          "description": "Color for model/library-inherited routing values (gold dotted)."
        },
        "cdp.routing.decorations.externalColor": {
          "type": "string",
          "default": "#B180D7",
          "description": "Color for external application routing values (purple dotted)."
        },
        "cdp.xml.decorations.names.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the value of Name=\"...\" attributes in CDP XML files."
        },
        "cdp.xml.decorations.nameColor": {
          "type": "string",
          "default": "#C5E478",
          "description": "Color for CDP Name attribute values (yellow-green, easy to spot in large XML files)."
        },
        "cdp.xml.decorations.nameFontWeight": {
          "type": "string",
          "default": "bold",
          "description": "Font weight for CDP Name attribute values (e.g. \"bold\" or \"normal\")."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies",
    "verify-routing": "node scripts/verify-routing.js",
    "verify-routing:golden": "node scripts/verify-routing.js /home/andmid04/systems/3dCraneBacklash"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0"
  }
}
